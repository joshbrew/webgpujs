{
  "name": "webgpujs",
  "version": "1.0.0",
  "description": "Write WebGPU compute and graphics pipelines as JavaScript functions or native WGSL.",
  "main": "./dist/webgpujs.esm.js",
  "module": "./dist/webgpujs.esm.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "start": "npm run example",
    "example": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "test:gpu": "node scripts/test.mjs --gpu",
    "typecheck": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.mjs",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:package -- --offline"
  },
  "keywords": [
    "webgpu",
    "wgsl",
    "gpu",
    "compute",
    "shader",
    "transpiler",
    "fft",
    "graphics"
  ],
  "author": "",
  "license": "LGPL-3.0-or-later",
  "nodemonConfig": {
    "env": {
      "NODEMON": true
    },
    "ignore": [
      "dist/",
      ".temp/"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "prettier": "^3.6.2",
    "typescript": "~7.0.2",
    "webgpu": "^0.6.2",
    "wgpu-matrix": "^2.9.1",
    "acorn": "^8.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/webgpujs.esm.js",
      "default": "./dist/webgpujs.esm.js"
    },
    "./webgpujs.js": "./dist/webgpujs.js",
    "./package.json": "./package.json",
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js",
      "default": "./dist/esbuild.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/index.d.ts",
    "dist/src/*.d.ts",
    "docs/API.md",
    "WEBGPU-COVERAGE.md",
    "LICENSE",
    "dist/esbuild.d.ts",
    "docs/RELEASING.md",
    "docs/COMPATIBILITY.md",
    "docs/verification/*.json",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "homepage": "https://webgpujs.netlify.app/"
}
