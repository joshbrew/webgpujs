{
  "name": "webgpujs",
  "version": "0.0.0",
  "description": "Barebones esbuild and test node server implementation. For building",
  "main": "./webgpujs.js",
  "module": "./dist/webgpujs.esm.js",
  "type": "module",
  "scripts": {
    "start": "npm --prefix .. run example",
    "build": "npm --prefix .. run build",
    "serve": "npm --prefix .. run serve"
  },
  "keywords": [
    "esbuild"
  ],
  "author": "",
  "license": "LGPL-3.0-or-later",
  "nodemonConfig": {
    "env": {
      "NODEMON": true
    },
    "ignore": [
      "dist/",
      ".temp/"
    ]
  },
  "devDependencies": {
    "@webgpu/types": "~0.1.37"
  },
  "dependencies": {
    "wgpu-matrix": "^2.5.1"
  }
}
